# Copy this file to server/.env or set these variables in your hosting service.
# SQLite defaults to server/data/hotel.sqlite.
PORT=5000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
# NODE_ENV=production
# PUBLIC_ORIGIN=https://your-hotel-domain.example
# TRUSTED_PROXY_ADDRESSES=127.0.0.1
# DATABASE_PATH=/absolute/path/to/hotel.sqlite

# Guest notifications. The public HTTPS origin is used for links in messages.
# NOTIFICATION_PUBLIC_ORIGIN=https://your-hotel-domain.example
# RESEND_API_KEY=
# NOTIFICATION_FROM=Pratap Palace <reservations@your-hotel-domain.example>
# RESEND_WEBHOOK_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# WHATSAPP_CONFIRMATION_TEMPLATE=
# WHATSAPP_QUOTE_TEMPLATE=
# WHATSAPP_REMINDER_TEMPLATE=
